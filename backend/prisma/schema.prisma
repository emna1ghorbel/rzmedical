generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TypeUtilisateur {
  ADMIN
  CLIENT
}

enum StatutCommande {
  EN_ATTENTE
  PAYEE
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum StatutFacture {
  BROUILLON
  EMISE
  ANNULEE
}

enum StatutSupport {
  NOUVEAU
  EN_COURS
  REPONDU
  FERME
}

enum CanalSupport {
  SUPPORT
  EMAIL
  TELEPHONE
}

enum AuteurSupport {
  CLIENT
  ADMIN
}

model Utilisateur {
  id               Int             @id @default(autoincrement())
  email            String          @unique
  motDePasseHash   String
  prenom           String?
  nom              String?
  telephone        String?
  photo            String?
  adresse          String?
  dateNaissance    DateTime?
  typeUtilisateur  TypeUtilisateur @default(CLIENT)
  remise           Decimal         @default(0) @db.Decimal(5, 2)
  matriculeFiscale String?
  activite         String?
  otpCode          String?
  otpExpire        DateTime?
  dernierLogin     DateTime?
  creeLe           DateTime        @default(now())
  misAJourLe       DateTime        @updatedAt

  commandes Commande[]
  ticketsSupport TicketSupport[]

  @@map("utilisateurs")
}

model TicketSupport {
  id              Int           @id @default(autoincrement())
  utilisateurId   Int?
  utilisateur     Utilisateur?  @relation(fields: [utilisateurId], references: [id])
  nomContact      String?
  emailContact    String?
  telephoneContact String?
  sujet           String
  message         String
  statut          StatutSupport @default(NOUVEAU)
  canalReponse    CanalSupport  @default(SUPPORT)
  reponse         String?
  reponduLe       DateTime?
  creeLe          DateTime      @default(now())
  misAJourLe      DateTime      @updatedAt
  messages        MessageSupport[]

  @@index([utilisateurId])
  @@index([statut])
  @@map("tickets_support")
}

model MessageSupport {
  id            Int           @id @default(autoincrement())
  ticketId      Int
  ticket        TicketSupport @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  auteur        AuteurSupport
  contenu       String
  canal         CanalSupport  @default(SUPPORT)
  creeLe        DateTime      @default(now())

  @@index([ticketId, creeLe])
  @@map("messages_support")
}

model Categorie {
  id         Int      @id @default(autoincrement())
  nom        String   @unique
  visible    Boolean  @default(true)
  creeLe     DateTime @default(now())
  misAJourLe DateTime @updatedAt

  sousCategories SousCategorie[]
  marques        Marque[]

  @@map("categories")
}

model SousCategorie {
  id          Int       @id @default(autoincrement())
  nom         String
  description String?
  image       String?
  categorieId Int
  categorie   Categorie @relation(fields: [categorieId], references: [id])
  creeLe      DateTime  @default(now())
  misAJourLe  DateTime  @updatedAt

  produits Produit[]

  @@unique([nom, categorieId])
  @@map("sous_categories")
}

model Marque {
  id          Int       @id @default(autoincrement())
  nom         String
  logo        String?
  categorieId Int
  categorie   Categorie @relation(fields: [categorieId], references: [id])
  creeLe      DateTime  @default(now())
  misAJourLe  DateTime  @updatedAt

  produits Produit[]

  @@unique([nom, categorieId])
  @@map("marques")
}

model Produit {
  id             Int           @id @default(autoincrement())
  nom            String
  reference      String        @unique
  description    String?
  expirationDate DateTime?
  prix           Decimal       @db.Decimal(10, 2)
  stock          Int           @default(0)
  images         String[]
  video          String?
  motsCles       String[]
  ficheTechnique String?
  remise         Decimal       @default(0) @db.Decimal(10, 2)
  disponible     Boolean       @default(true)
  sousCategorieId Int
  sousCategorie  SousCategorie @relation(fields: [sousCategorieId], references: [id])
  marqueId       Int
  marque         Marque        @relation(fields: [marqueId], references: [id])
  creeLe         DateTime      @default(now())
  misAJourLe     DateTime      @updatedAt

  lignesCommande LigneCommande[]

  @@index([sousCategorieId])
  @@index([marqueId])
  @@map("produits")
}

model Commande {
  id            Int            @id @default(autoincrement())
  utilisateurId Int
  utilisateur   Utilisateur    @relation(fields: [utilisateurId], references: [id])
  statut        StatutCommande @default(EN_ATTENTE)
  total         Decimal        @db.Decimal(10, 2)
  creeLe        DateTime       @default(now())
  misAJourLe    DateTime       @updatedAt

  lignes  LigneCommande[]
  facture Facture?

  @@index([utilisateurId])
  @@map("commandes")
}

model LigneCommande {
  id           Int      @id @default(autoincrement())
  commandeId   Int
  commande     Commande @relation(fields: [commandeId], references: [id])
  produitId    Int
  produit      Produit  @relation(fields: [produitId], references: [id])
  quantite     Int
  prixUnitaire Decimal  @db.Decimal(10, 2)

  @@index([commandeId])
  @@index([produitId])
  @@map("lignes_commande")
}

model Facture {
  id               Int           @id @default(autoincrement())
  numero           String        @unique
  statut           StatutFacture @default(EMISE)
  commandeId       Int           @unique
  commande         Commande      @relation(fields: [commandeId], references: [id])
  dateEmission     DateTime

  // Snapshot client (immuable après finalisation)
  clientNom        String
  clientMF         String?
  clientAdresse    String?
  clientTelephone  String?
  clientEmail      String?

  // Fiscalité (3 décimales TND)
  timbreFiscal     Decimal       @default(1.000) @db.Decimal(10, 3)
  montantHT        Decimal       @db.Decimal(10, 3)
  montantTVA       Decimal       @db.Decimal(10, 3)
  montantTTC       Decimal       @db.Decimal(10, 3)
  montantEnLettres String?

  fichierPdf       String?
  creeLe           DateTime      @default(now())
  misAJourLe       DateTime      @updatedAt

  lignes           LigneFacture[]

  @@index([statut])
  @@map("factures")
}

model LigneFacture {
  id             Int     @id @default(autoincrement())
  factureId      Int
  facture        Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  designation    String
  quantite       Decimal @db.Decimal(10, 3)
  prixUnitaireHT Decimal @db.Decimal(10, 3)
  tauxTVA        Decimal @db.Decimal(5, 2)
  totalHT        Decimal @db.Decimal(10, 3)

  @@index([factureId])
  @@map("lignes_facture")
}

model AnnonceSite {
  id            Int      @id @default(autoincrement())
  texte         String
  actif         Boolean  @default(true)
  ordre         Int      @default(0)
  dureeSecondes Int      @default(5)
  creeLe        DateTime @default(now())
  misAJourLe    DateTime @updatedAt
  @@map("annonces_site")
}

model BanniereSite {
  id          Int       @id @default(autoincrement())
  image       String
  titre       String?
  description String?
  lien        String?
  hauteur     Int       @default(420)
  actif       Boolean   @default(true)
  ordre       Int       @default(0)
  dateDebut   DateTime?
  dateFin     DateTime?
  creeLe      DateTime  @default(now())
  misAJourLe  DateTime  @updatedAt
  @@map("bannieres_site")
}

model VideoHero {
  id         Int      @id @default(autoincrement())
  videoUrl   String
  posterUrl  String?
  titre      String?
  actif      Boolean  @default(false)
  creeLe     DateTime @default(now())
  misAJourLe DateTime @updatedAt
  @@map("videos_hero")
}
